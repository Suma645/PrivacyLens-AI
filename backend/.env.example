# SnapShield Backend Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars

# OCR Configuration
# On Render / Ubuntu Linux: tesseract is installed in /usr/bin/tesseract
# On Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract

# Optional Cloud AI Integration
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
